{
  "$schema": "https://opencode.ai/config.json",
  "model": "Nvidia/Nemotron 3.5 Lightning 30B A3B",
  "default_agent": "plan",
  "share": "disabled",
  "snapshots": true,
  "compaction": {
    "auto": true
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      "dist/**",
      "build/**"
    ]
  },
  "formatter": true,
  "lsp": true,
  "permissions": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": "ask",
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask"
  },
  "agents": {
    "plan": {
      "temperature": 0.2
    },
    "build": {
      "temperature": 0.1
    }
  }
}
