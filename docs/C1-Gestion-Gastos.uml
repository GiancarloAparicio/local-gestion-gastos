@startuml
skinparam DefaultTextAlignment center
title C1: Arquitectura General - local-gestion-gastos

state "USUARIO" as usuario
state "MAIN PYTHON" as main
state "ADAPTADORES" as adaptadores
state "MODULIOS" as modulos
state "BASE DATOS SQLite" as bd
state "LOGS" as logs

usuario --> main: Interacciones CLI
main --> adaptadores: Llamar adaptadores
main --> modulos: Llamar módulos
adaptadores --> bd: Insertar/Leer transacciones
modulos --> bd: Validaciones y utilidades
bd --> logs: Guardar historial
logs --> usuario: Reportes y vistas

@enduml
