@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Nivel 2: Diagrama de Contenedores - Sistema de Gestión de Gastos (Vista Unificada)

' ----------------------------
' Actores y Sistemas Externos
' ----------------------------
Person(user, "Usuario", "Realiza pagos/ingresos y proporciona el contexto o motivo de los movimientos.")
System_Ext(banks, "Bancos y Billeteras Digitales", "Yape, Plin, BBVA, Interbank, NFC, Compartamos. Generan las alertas.")
System_Ext(looker, "Looker Studio", "Visualiza reportes, gráficos y métricas de gasto.")

' ----------------------------
' Contenedores del Dispositivo Móvil (Android)
' ----------------------------
System_Boundary(mobile_env, "Dispositivo Android (Entorno Local)") {
    Container(automate, "Sensor de Notificaciones", "Automate App", "Intercepta de forma ligera la notificación push del banco y lanza el disparador.")
    Container(termux, "Motor de Automatización", "Termux / Python", "Procesa metadatos, obtiene ubicación GPS y gestiona la lógica.")
    Container(dialog_api, "Gestor de Interfaz Local", "Termux:API (termux-dialog)", "Despliega las ventanas emergentes para solicitar el motivo al usuario.")
    ContainerDb(sqlite, "Base de Datos Local", "SQLite", "Almacena una copia de respaldo offline de las transacciones.")
}

' ----------------------------
' Contenedores de la Nube (Backend)
' ----------------------------
System_Boundary(cloud_env, "Infraestructura Cloud") {
    Container(api, "API de Gastos", "Google Cloud Function (Python)", "Recibe peticiones HTTP, valida esquemas y procesa la data.")
    ContainerDb(sheets, "Base de Datos Cloud", "Google Sheets", "Almacena de forma estructurada el historial definitivo.")
}

' ----------------------------
' Relaciones y Flujo General
' ----------------------------
Rel(user, banks, "Realiza consumos", "Físico / App / NFC")
Rel(banks, automate, "Emite notificación de movimiento", "Android Push")

Rel(automate, termux, "Dispara ejecución de script", "Broadcast / Trigger")
Rel(termux, dialog_api, "Solicita input de usuario", "Comando Termux:API")
Rel(dialog_api, user, "Muestra diálogo flotante", "UI Android")
Rel(user, dialog_api, "Ingresa el motivo del gasto/ingreso", "Input de texto")
Rel(dialog_api, termux, "Retorna el motivo capturado", "Standard Output")

Rel(termux, sqlite, "Registra backup local", "SQL Driver")
Rel(termux, api, "Sincroniza transacciones pendientes", "HTTPS / API REST")

Rel(api, sheets, "Inserta y actualiza filas de registros", "Google Sheets API")
Rel(sheets, looker, "Alimenta tableros analíticos", "Conector nativo")

@enduml
