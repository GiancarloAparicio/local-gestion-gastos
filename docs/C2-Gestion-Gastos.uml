@startuml
skinparam DefaultTextAlignment center
title C2: Flujo de Trabajo - Procesamiento de Notificaciones

state "INICIO" as start
state "NOTIFICACIÓN RECIBIDA" as recv
state "VALIDAR PAQUETE" as validar
state "CLASIFICAR FORMATO" as clasificar
state "PROCESAR CON IC" as procesar
state "SOLICITAR MOTIVO" as motivo
state "VALIDAR DUPLICADOS" as duplicados
state "CONSOLIDAR O INSERTAR" as db
state "FIN" as end

state "FORMATOS SOPORTADOS" as formatos
state "TRAN: Mismo tipo NUNCA duplicado" as tran_rule
state "PLIN: Mismo tipo NUNCA duplicado" as plin_rule
state "TARJETA: Mismo tipo NUNCA duplicado" as tarjeta_rule
state "NFC: Mismo tipo NUNCA duplicado" as nfc_rule
state "Consolidar tipos DIFERENTES" as consolidar_regla

start -> recv: Notificación recibida desde Automate/FIFO
recv --> validar: ¿Es paquete conocido?
validar --> clasificar: Sí, paquete conocido
validar -> end: No, ignorar

clasificar --> procesar: Formato = TRAN, PLIN, TARJETA o NFC
procesar --> motivo: Siempre solicitar motivo via termux-dialog
motivo --> duplicados: ¿Es duplicado?

duplicados --> tran_rule: ¿Es TRAN + TRAN?
tran_rule --> duplicados: No (NUNCA duplicado)
tran_rule --> consolidar_regla: Consolidar si tipo diferente

duplicados --> plin_rule: ¿Es PLIN + PLIN?
plin_rule --> duplicados: No (NUNCA duplicado)
plin_rule --> consolidar_regla: Consolidar si tipo diferente

duplicados --> tarjeta_rule: ¿Es TARJETA + TARJETA?
tarjeta_rule --> duplicados: No (NUNCA duplicado)
tarjeta_rule --> consolidar_regla: Consolidar si tipo diferente

duplicados --> nfc_rule: ¿Es NFC + NFC?
nfc_rule --> duplicados: No (NUNCA duplicado)
nfc_rule --> consolidar_regla: Consolidar si tipo diferente

duplicados --> consolidar_regla: Tipos DIFERENTES consolidan
consolidar_regla --> db: Insertar/Actualizar consolidado
db --> end: Actualizar/Sin duplicados

@enduml
