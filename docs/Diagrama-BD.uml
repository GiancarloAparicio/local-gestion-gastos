@startuml
skinparam DefaultTextAlignment center
title Diagrama de Base de Datos - local_gastos.db

state "TABLA: transacciones" as transacciones
state "TABLA: notificaciones_crudas" as nc
state "TABLA: abonos_prestamo" as ap

state "ID" as id_pk
state "ID_TRANSACCION" as id_trans
state "FECHA_HORA_EPOCH" as fecha_ep
state "FECHA_ISO" as fecha_iso
state "FECHA" as fecha
state "HORA" as hora
state "TRIMESTRE" as trimestre
state "APP" as app
state "PAQUETE" as paquete
state "DISPOSITIVO" as dispositivo
state "TIPO" as tipo
state "MOTIVO" as motivo
state "MONTO_TOTAL" as monto_total
state "MONEDA" as moneda
state "DESTINATARIO" as destinatario
state "CATEGORIA" as categoria
state "E_PRESTAMO" as es_prestamo
state "MONTO_PAGADO" as monto_pagado
state "SALDO_PENDIENTE" as saldo_pendiente
state "ESTADO_PRESTAMO" as estado_prestamo
state "LOOKER" as looker
state "LATITUD" as latitud
state "LONGITUD" as longitud
state "FUENTE_GPS" as fuente_gps
state "MENSAJE_RAW" as mensaje_raw
state "STATUS" as status
state "SINCRONIZADO" as sincronizado
state "INTENTOS_SYNC" as intentos_sync
state "ULTIMO_ERROR_SYNC" as ultimo_error_sync

transacciones --> id_pk: PK
transacciones --> id_trans: FK opcional
transacciones --> fecha_ep: timestamp
transacciones --> fecha_iso: texto
transacciones --> fecha: fecha
transacciones --> hora: hora
transacciones --> trimestre: trimestre
transacciones --> app: paquete origen
transacciones --> paquete: nombre paquete
transacciones --> dispositivo: dispositivo
transacciones --> tipo: gasto/ingreso
transacciones --> motivo: motivo del movimiento
transacciones --> monto_total: monto numérico
transacciones --> moneda: PEN/USD/etc
transacciones --> destinatario: nombre beneficiario
transacciones --> categoria: categoría gasto
transacciones --> es_prestamo: 0/1
transacciones --> monto_pagado: monto pagado
transacciones --> saldo_pendiente: saldo restante
transacciones --> estado_prestamo: estado préstamo
transacciones --> looker: identificador interno
transacciones --> latitud: coordenada GPS
transacciones --> longitud: coordenada GPS
transacciones --> fuente_gps: fuente GPS
transacciones --> mensaje_raw: notificación raw

nc --> id_pk: PK
ap --> id_pk: PK

@enduml
