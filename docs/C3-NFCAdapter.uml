@startuml
skinparam DefaultTextAlignment center
title Proceso NFC: Google Pay / walletnfcrel

state "INICIO" as start
state "Recibir notificación NFC" as recv
state "CLASIFICAR FORMATO NFC" as clasificar_nfc
state "Extraer datos: monto, beneficiario, tipo" as datos_nfc
state "SOLICITAR MOTIVO NFC" as motivo_nfc
state "Validar Duplicados NFC" as duplicados_nfc
state "Validar Consolidación IBK" as consolidar_ibk
state "INSERTAR/Actualizar SQLite" as db
state "FIN" as end

start -> recv: Notificación NFC recibida
recv --> clasificar_nfc: ¿Es walletnfcrel?
clasificar_nfc --> datos_nfc: Sí, extraer monto/beneficiario
datos_nfc --> motivo_nfc: Solicitar motivo via termux-dialog
motivo_nfc --> duplicados_nfc: ¿Es duplicado?

duplicados_nfc --> nfc_rule: ¿Es NFC + NFC?
nfc_rule --> duplicados_nfc: No (NUNCA duplicado - mismo tipo)
nfc_rule --> consolidar_ibk: Consolidar si tipo diferente a IBK

consolidar_ibk --> db: Consolidar con IBK (NFC + TARJETA/TRAN/PLIN)
nfc_rule --> db: Insertar nuevo registro NFC
db --> end: Actualizar registro consolidado
db --> end: Insertar nuevo registro NFC

@enduml
