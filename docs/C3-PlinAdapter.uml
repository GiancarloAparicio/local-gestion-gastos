@startuml
skinparam DefaultTextAlignment center
title Proceso de Plin: Ingresos y Gastos (Cuenta / Tarjeta) en Cola FIFO

start

:Automate entrega notificacion desde cola FIFO;
:Dispatcher enruta al parser de Plin;

:Parsear notificacion Plin\n(tipo: ingreso o gasto, monto, persona, canal);
if (Es notificacion valida de Plin?) then (Si)
else (No)
    stop
endif

if (Es ingreso por Plin?) then (Si)
    :Pedir motivo con termux-dialog\n(con timeout y validacion de texto);
    :Obtener GPS con termux-location\n(con timeout);
    if (GPS valido?) then (Si)
        :Usar coordenadas actuales\n(gps_source = live);
    else (No / Error / Timeout)
        :Consultar ultima coordenada valida en SQLite;
        if (Existe ubicacion previa?) then (Si)
            :Usar ultima ubicacion\n(gps_source = last_known);
        else (No)
            :Dejar ubicacion nula\n(gps_source = none);
        endif
    endif
    :Generar event_id e insertar ingreso\nen SQLite (status = consolidated, synced = 0);
else (No: es gasto por Plin)
    :Buscar en SQLite gasto Plin reciente\nen ventana de tiempo\n(mismo monto, persona o borrador previo:\nprenotificacion, Plin o tarjeta);
    if (Ya existe registro de este gasto?) then (Si)
        :Consolidar notificacion adicional en SQLite\n(2da o 3ra alerta: prenotificacion / Plin / tarjeta):\n- Anexar muestra cruda\n- Completar monto, persona o metodo (cuenta / tarjeta)\n- No repetir termux-dialog;
        :Marcar status = consolidated y synced = 0;
    else (No: es la 1ra notificacion del gasto)
        :Pedir motivo con termux-dialog\n(una sola vez, con timeout);
        :Obtener GPS con termux-location\n(con timeout);
        if (GPS valido?) then (Si)
            :Usar coordenadas actuales\n(gps_source = live);
        else (No / Error / Timeout)
            :Consultar ultima coordenada valida en SQLite;
            if (Existe ubicacion previa?) then (Si)
                :Usar ultima ubicacion\n(gps_source = last_known);
            else (No)
                :Dejar ubicacion nula\n(gps_source = none);
            endif
        endif
        :Generar event_id e insertar gasto Plin\nen SQLite (status = consolidated, synced = 0);
    endif
endif

if (Hay conexion a Internet?) then (Si)
    :Enviar payload JSON (con event_id)\na Google Cloud Function;
    if (Respuesta 2xx?) then (Si)
        :Actualizar synced = 1 en SQLite;
    else (No)
        :Mantener synced = 0 en SQLite;
    endif
else (No)
    :Mantener synced = 0 en SQLite\n(Modo Offline);
endif

stop
@enduml
